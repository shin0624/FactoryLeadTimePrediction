<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)torchsharp\0.107.0\buildTransitive\net8.0\TorchSharp.targets" Condition="Exists('$(NuGetPackageRoot)torchsharp\0.107.0\buildTransitive\net8.0\TorchSharp.targets')" />
    <Import Project="$(NuGetPackageRoot)torchvision\0.107.0\buildTransitive\net8.0\TorchVision.targets" Condition="Exists('$(NuGetPackageRoot)torchvision\0.107.0\buildTransitive\net8.0\TorchVision.targets')" />
    <Import Project="$(NuGetPackageRoot)microsoft.ml\6.0.0\build\netstandard2.0\Microsoft.ML.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.ml\6.0.0\build\netstandard2.0\Microsoft.ML.targets')" />
    <Import Project="$(NuGetPackageRoot)lightgbm\4.6.0\build\LightGBM.targets" Condition="Exists('$(NuGetPackageRoot)lightgbm\4.6.0\build\LightGBM.targets')" />
    <Import Project="$(NuGetPackageRoot)libtorch-cpu-win-x64\2.10.0\buildTransitive\netstandard2.0\libtorch-cpu-win-x64.targets" Condition="Exists('$(NuGetPackageRoot)libtorch-cpu-win-x64\2.10.0\buildTransitive\netstandard2.0\libtorch-cpu-win-x64.targets')" />
  </ImportGroup>
</Project>