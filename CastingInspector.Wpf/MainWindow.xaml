<Window x:Class="CastingInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="주조품 외관 검사기 (Grad-CAM)" Height="760" Width="1180"
        Background="#1E1E1E">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 상단 : 버튼/상태 -->
            <RowDefinition Height="*"/>      <!-- 중단 : 이미지 2개 -->
            <RowDefinition Height="Auto"/>   <!-- 하단 : 판정/확률 -->
        </Grid.RowDefinitions>

        <!-- ========== 상단 ========== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnOpen" Content="이미지 선택" Width="120" Height="36"
                    Click="BtnOpen_Click" IsEnabled="False"/>

            <CheckBox x:Name="ChkBox" Content="바운딩박스 표시" Foreground="#CCCCCC"
                      VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>
                      
             <TextBlock Text="표시" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <ComboBox x:Name="CmbMode" Width="130" VerticalAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="오버레이"/>
                <ComboBoxItem Content="히트맵만"/>
                <ComboBoxItem Content="원본+히트맵"/>
            </ComboBox>

            <CheckBox x:Name="ChkColorBar" Content="컬러바" Foreground="#CCCCCC"
                      VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="히트맵 임계값" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="20,0,6,0"/>
            <Slider x:Name="SldThreshold" Width="110" Minimum="0.1" Maximum="0.9" Value="0.5"
                    VerticalAlignment="Center" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="TxtThresholdVal" Text="0.50" Foreground="#CCCCCC"
                       VerticalAlignment="Center" Margin="6,0,0,0" Width="34"/>
            <!-- 슬라이더는 재추론 없이 박스만 다시 그린다. 히트맵은 이미 계산되어 있으므로 즉시 반응한다. -->

            <TextBlock x:Name="TxtStatus" Text="모델 로딩 중..." Foreground="#CCCCCC"
                       VerticalAlignment="Center" Margin="20,0,0,0" FontSize="13"/>
        </StackPanel>

        <!-- ========== 중단 : (좌) 원본 | (우) Grad-CAM ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌 : 원본 -->
            <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1" Margin="0,0,8,0">
                <Grid>
                    <Image x:Name="ImgOriginal" Stretch="Uniform" Margin="8"/>
                    <TextBlock Text="원본" Foreground="#888" FontSize="12"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                </Grid>
            </Border>

            <!-- 우 : Grad-CAM 오버레이 -->
            <Border Grid.Column="1" BorderBrush="#444" BorderThickness="1" Margin="8,0,0,0">
                <Grid>
                    <!-- 오버레이 이미지와 박스를 겹쳐 그리기 위해 Canvas를 쓴다 -->
                    <Image x:Name="ImgHeatmap" Stretch="Uniform" Margin="8"/>
                    <Canvas x:Name="BoxCanvas" Margin="8" Background="Transparent"/>
                    <TextBlock Text="Grad-CAM (모델이 주목한 영역)" Foreground="#888" FontSize="12"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                    <!--
                    "결함 영역"이 아니라 "주목 영역"이라고 쓴 이유
                        - Grad-CAM은 픽셀 단위 결함 마스크가 아니다. 마스크 라벨로 학습된 것이 아니다.
                        - "모델이 이 클래스로 판단할 때 기여한 영역"이 정확한 의미다.
                        - UI 문구를 과장하면 나중에 본인도 헷갈린다.
                    -->
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 하단 : 판정 + 확률 ========== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 판정 배너 -->
            <Border x:Name="BorderVerdict" Grid.Column="0" Background="#333" CornerRadius="6"
                    Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock x:Name="TxtVerdict" Text="—" FontSize="34" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtConfidence" Text="이미지를 선택하세요" FontSize="13"
                               Foreground="#DDDDDD" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 확률 막대 + 상세 -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="불량 확률" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,3"/>
                <Grid Height="22" Margin="0,0,0,8">
                    <Rectangle Fill="#333" RadiusX="4" RadiusY="4"/>
                    <Rectangle x:Name="BarDefect" Fill="#E05555" RadiusX="4" RadiusY="4"
                               HorizontalAlignment="Left" Width="0"/>
                    <TextBlock x:Name="TxtDefectPct" Text="0.0%" Foreground="White" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="정상 확률" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,3"/>
                <Grid Height="22" Margin="0,0,0,8">
                    <Rectangle Fill="#333" RadiusX="4" RadiusY="4"/>
                    <Rectangle x:Name="BarOk" Fill="#55B055" RadiusX="4" RadiusY="4"
                               HorizontalAlignment="Left" Width="0"/>
                    <TextBlock x:Name="TxtOkPct" Text="0.0%" Foreground="White" FontSize="11"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock x:Name="TxtDetail" Text="파일 : —   |   추론+GradCAM : —   |   주목영역 : —"
                           Foreground="#AAAAAA" FontSize="11"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
