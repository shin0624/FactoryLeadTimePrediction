<Window x:Class="CastingInspector.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CastingInspector.Wpf"
        mc:Ignorable="d"
        Title="주조품 외관 검사기" Height="640" Width="900"
        Background="#1E1E1E">
     <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>  <!-- 왼쪽 : 이미지 미리보기 -->
            <ColumnDefinition Width="*"/>    <!-- 오른쪽 : 판정 결과 -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 상단 : 버튼/상태 -->
            <RowDefinition Height="*"/>      <!-- 본문 -->
        </Grid.RowDefinitions>

        <!-- ========== 상단 : 모델 로딩 상태 + 파일 선택 ========== -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnOpen" Content="이미지 선택" Width="120" Height="36"
                    Click="BtnOpen_Click" IsEnabled="False"/>
            <!-- IsEnabled=False로 시작한다. 모델 로딩이 끝나야 활성화된다.
                 로딩 전에 누르면 NullReferenceException이 나므로 UI 차원에서 막는 것이 안전하다. -->

            <TextBlock x:Name="TxtStatus" Text="모델 로딩 중..." Foreground="#CCCCCC"
                       VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>
        </StackPanel>

        <!-- ========== 왼쪽 : 이미지 미리보기 ========== -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#444" BorderThickness="1" Margin="0,0,16,0">
            <Image x:Name="ImgPreview" Stretch="Uniform" Margin="8"/>
            <!-- Stretch="Uniform" : 비율을 유지하며 맞춘다. Fill로 두면 300x300과 512x512가 다르게 찌그러진다. -->
        </Border>

        <!-- ========== 오른쪽 : 판정 결과 ========== -->
        <StackPanel Grid.Row="1" Grid.Column="1">

            <!-- 판정 배너 : 배경색으로 한눈에 구분 -->
            <Border x:Name="BorderVerdict" Background="#333" CornerRadius="6" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="TxtVerdict" Text="—" FontSize="42" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtConfidence" Text="이미지를 선택하세요" FontSize="14"
                               Foreground="#DDDDDD" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 확률 막대 : 불량 -->
            <TextBlock Text="불량 확률" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,4"/>
            <Grid Height="26" Margin="0,0,0,12">
                <Rectangle Fill="#333" RadiusX="4" RadiusY="4"/>
                <Rectangle x:Name="BarDefect" Fill="#E05555" RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Left" Width="0"/>
                <!-- Width를 코드에서 설정한다. 막대 그래프를 Rectangle 두 장(배경+전경)으로 만드는 기본 패턴. -->
                <TextBlock x:Name="TxtDefectPct" Text="0.0%" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- 확률 막대 : 정상 -->
            <TextBlock Text="정상 확률" Foreground="#CCCCCC" FontSize="13" Margin="0,0,0,4"/>
            <Grid Height="26" Margin="0,0,0,20">
                <Rectangle Fill="#333" RadiusX="4" RadiusY="4"/>
                <Rectangle x:Name="BarOk" Fill="#55B055" RadiusX="4" RadiusY="4"
                           HorizontalAlignment="Left" Width="0"/>
                <TextBlock x:Name="TxtOkPct" Text="0.0%" Foreground="White" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- 상세 정보 -->
            <Border Background="#2A2A2A" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="TxtFileName" Text="파일 : -" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtElapsed"  Text="추론 시간 : -" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtThreshold" Text="판정 임계값 : 0.50 (기본값)" Foreground="#AAAAAA" FontSize="12"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
